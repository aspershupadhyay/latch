{
  "name": "latch-gateway-vercel",
  "version": "0.1.0",
  "private": true,
  "description": "Latch relay for Vercel and Cloudflare Workers: MCP for AI clients and an HTTP long-poll channel for phones, over Upstash Redis (Vercel) or a Durable Object's SQLite (Cloudflare).",
  "license": "AGPL-3.0-only",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "pretest": "cargo build --quiet -p latch-fake-device",
    "test": "tsx --test test/*.test.ts",
    "dev": "tsx src/local.ts",
    "smoke": "rm -rf .smoke && tsc --outDir .smoke --noEmit false && node scripts/smoke.mjs",
    "smoke:cloudflare": "node scripts/smoke-cloudflare.mjs",
    "deploy": "npx --yes wrangler@4.158.0 deploy"
  },
  "dependencies": {
    "@upstash/redis": "1.39.0",
    "@vercel/blob": "2.8.0",
    "qrcode-generator": "2.0.4"
  },
  "devDependencies": {
    "@modelcontextprotocol/sdk": "1.32.1",
    "@types/node": "26.6.6",
    "tsx": "4.23.15",
    "typescript": "7.0.2"
  },
  "overrides": {
    "zod": "4.6.7"
  },
  "cloudflare": {
    "bindings": {
      "LATCH_CLAIM": {
        "description": "Leave it as `first`: the Latch phone that scans this relay's page first (within 24 hours) becomes its owner. Nothing to type."
      }
    }
  }
}
