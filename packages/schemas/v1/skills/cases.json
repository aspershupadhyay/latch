{
  "skill": {
    "name": "order_groceries",
    "description": "Order items in the shop app",
    "app": "Shop",
    "params": [
      {
        "name": "items",
        "type": "list",
        "fields": [
          "name",
          "qty"
        ],
        "description": "What to buy"
      },
      {
        "name": "note",
        "type": "text",
        "default": "leave at door"
      }
    ],
    "steps": [
      {
        "do": "launch_app",
        "package": "org.latch.demo.shop"
      },
      {
        "for_each": "items",
        "steps": [
          {
            "do": "type",
            "target": "Search products",
            "text": "{item.name}",
            "submit": true
          },
          {
            "do": "tap",
            "target": "ADD",
            "near": "{item.name}"
          },
          {
            "do": "tap",
            "target": "+",
            "near": "{item.name}",
            "repeat": "{item.qty-1}"
          }
        ]
      },
      {
        "do": "tap",
        "target": "Not now",
        "optional": true
      },
      {
        "do": "wait_for",
        "text": "Cart"
      },
      {
        "do": "type",
        "text": "{note}"
      },
      {
        "do": "press",
        "button": "back"
      }
    ]
  },
