  "find": [
    "n12",
    "n15",
    null,
    "n10",
    "n10",
    "n1",
    "n1",
    null,
    "b",
    "b",
    "b",
    "a",
    null,
    "n15",
    "n12",
    "n15"
  ],
  "validate": [
    {
      "ok": {
        "app": "Shop",
        "description": "Order items in the shop app",
        "name": "order_groceries",
        "params": [
          {
            "description": "What to buy",
            "fields": [
              "name",
              "qty"
            ],
            "name": "items",
            "type": "list"
          },
          {
            "default": "leave at door",
            "name": "note",
            "type": "text"
          }
        ],
        "steps": [
          {
            "do": "launch_app",
            "package": "org.latch.demo.shop"
          },
          {
            "for_each": "items",
            "steps": [
              {
                "do": "type",
                "submit": true,
                "target": "Search products",
                "text": "{item.name}"
              },
              {
                "do": "tap",
                "near": "{item.name}",
                "target": "ADD"
              },
              {
                "do": "tap",
                "near": "{item.name}",
                "repeat": "{item.qty-1}",
                "target": "+"
              }
            ]
          },
          {
            "do": "tap",
            "optional": true,
            "target": "Not now"
          },
          {
            "do": "wait_for",
            "text": "Cart"
          },
          {
            "do": "type",
            "text": "{note}"
          },
          {
            "button": "back",
            "do": "press"
          }
        ]
      }
    },
    {
      "error": "name must be 1 to 40 characters: lowercase letters, digits, - and _"
    },
    {
      "error": "1 to 50 steps"
    },
    {
      "error": "each step needs do: one of launch_app, tap, type, scroll_to, wait_for, press, ask_owner, or for_each"
    },
    {
      "error": "step tap: 'target' is required"
    },
    {
      "error": "step tap: unknown field 'x'"
    },
    {
      "error": "for_each must name a list param (got 'nope')"
    },
    {
      "error": "for_each cannot be nested"
    },
    {
      "error": "param names are 1 to 24 characters: a lowercase letter, then letters, digits, or _ (not \"item\")"
    },
    {
      "error": "step press: button must be back, home, or recents"
    },
    {
      "error": "step tap: repeat must be 0 to 50"
    }
  ]
