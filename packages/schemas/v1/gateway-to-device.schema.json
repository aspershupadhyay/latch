{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "GatewayToDevice",
  "description": "Messages the gateway sends to a phone.",
  "oneOf": [
    {
      "type": "object",
      "properties": {
        "connection": {
          "description": "HTTP transport only: identifies this connection in later poll and\nmessage requests. A newer `hello` replaces it (since 1.1).",
          "type": [
            "string",
            "null"
          ]
        },
        "device_id": {
          "type": "string"
        },
        "protocol": {
          "type": "string"
        },
        "server_time_ms": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "type": {
          "type": "string",
          "const": "welcome"
        }
      },
      "required": [
        "type",
        "protocol",
        "device_id",
        "server_time_ms"
      ]
    },
    {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "const": "command"
        }
      },
      "$ref": "#/$defs/CommandEnvelope",
      "required": [
        "type"
      ]
    },
    {
      "description": "Abandon a command if it has not run yet. Best effort.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "type": {
          "type": "string",
          "const": "cancel"
        }
      },
      "required": [
        "type",
        "id"
      ]
    },
    {
      "description": "The gateway owner revoked this device. Forget the credential and disconnect.",
      "type": "object",
      "properties": {
        "reason": {
          "type": "string"
        },
        "type": {
          "type": "string",
          "const": "revoked"
        }
      },
      "required": [
        "type",
        "reason"
      ]
    },
    {
      "description": "Since 1.4: the owner answered an [`ApprovalRequest`] in the AI app. The\nphone applies it only if the nonce matches its open request and the\nowner's `remote_approvals` switch is on.",
      "type": "object",
      "properties": {
        "choice": {
          "$ref": "#/$defs/ApprovalChoice"
        },
        "nonce": {
          "type": "string"
        },
        "type": {
          "type": "string",
          "const": "approval_answer"
        }
      },
      "required": [
        "type",
        "nonce",
        "choice"
      ]
    }
  ],
  "$defs": {
    "ActivityKind": {
      "description": "Since 1.8: what an activity log entry is about.",
      "oneOf": [
        {
          "description": "A session started, stopped, paused, or ended.",
          "type": "string",
          "const": "session"
        },
        {
          "description": "The phone connected to or lost the gateway.",
          "type": "string",
          "const": "connection"
        },
        {
          "description": "The AI read the screen or the app list.",
          "type": "string",
          "const": "screen"
        },
        {
          "description": "The AI acted: tapped, typed, swiped, opened an app, copied text.",
          "type": "string",
          "const": "action"
        },
        {
          "description": "The owner let the AI use an app, or said not now.",
          "type": "string",
          "const": "app"
        },
        {
          "description": "The owner was asked to approve something, and the answer.",
          "type": "string",
          "const": "approval"
        },
        {
          "description": "Something was refused: by the owner, by a rule, or because it failed.",
          "type": "string",
          "const": "refusal"
        },
        {
          "description": "A file was listed, read, saved, renamed, deleted, or moved by link.",
          "type": "string",
          "const": "file"
        },
        {
          "description": "A folder was listed or created.",
          "type": "string",
          "const": "folder"
        },
        {
          "description": "The AI said a task was done.",
          "type": "string",
          "const": "task"
        }
      ]
    },
    "ApprovalChoice": {
      "description": "An answer to an approval (since 1.4).",
      "type": "string",
      "enum": [
        "once",
        "session",
        "always",
        "deny"
      ]
    },
    "Command": {
      "description": "One device operation. Serialized as `{\"name\": \"...\", \"params\": {...}}`.",
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "name": {
              "type": "string",
              "const": "device.info"
            },
            "params": {
              "type": "object"
            }
          },
          "required": [
            "name",
            "params"
          ]
        },
        {
          "description": "Capture the current screen as a redacted element tree, optionally with a screenshot.",
          "type": "object",
          "properties": {
            "name": {
              "type": "string",
              "const": "ui.observe"
            },
            "params": {
              "type": "object",
              "properties": {
                "include_screenshot": {
                  "type": "boolean",
                  "default": false
                },
                "max_nodes": {
                  "type": "integer",
                  "format": "uint32",
                  "default": 400,
                  "minimum": 0
                }
              }
            }
          },
          "required": [
            "name",
            "params"
          ]
        },
        {
          "type": "object",
          "properties": {
            "name": {
              "type": "string",
              "const": "input.tap"
            },
            "params": {
              "type": "object",
              "properties": {
                "double": {
                  "description": "Since 1.3: two quick taps (zoom a map, like a photo). Not with `long_press`.",
                  "type": "boolean"
                },
                "long_press": {
                  "type": "boolean",
                  "default": false
                },
                "observation_id": {
                  "type": "string"
                },
                "target": {
                  "$ref": "#/$defs/Target"
                }
              },
              "required": [
                "observation_id",
                "target"
              ]
            }
          },
          "required": [
            "name",
            "params"
          ]
        },
        {
          "type": "object",
          "properties": {
            "name": {
              "type": "string",
              "const": "input.swipe"
            },
            "params": {
              "type": "object",
              "properties": {
                "duration_ms": {
                  "type": "integer",
                  "format": "uint32",
                  "default": 300,
                  "minimum": 0
                },
                "from": {
                  "$ref": "#/$defs/Point"
                },
                "hold_ms": {
                  "description": "Since 1.3: press and hold at `from` this long before moving, which\ndrags (icons, list items, sliders) instead of scrolling.",
                  "type": "integer",
                  "format": "uint32",
                  "minimum": 0
                },
                "observation_id": {
                  "type": "string"
                },
                "to": {
                  "$ref": "#/$defs/Point"
                }
              },
              "required": [
                "observation_id",
                "from",
                "to"
              ]
            }
          },
          "required": [
            "name",
            "params"
          ]
        },
        {
          "description": "Since 1.3: two fingers moving apart (`end_span` > `start_span`, zoom\nin) or together (zoom out) around `center`, horizontally.",
          "type": "object",
          "properties": {
            "name": {
              "type": "string",
              "const": "input.pinch"
            },
            "params": {
              "type": "object",
              "properties": {
                "center": {
                  "$ref": "#/$defs/Point"
                },
                "duration_ms": {
                  "type": "integer",
                  "format": "uint32",
                  "default": 300,
                  "minimum": 0
                },
                "end_span": {
                  "type": "integer",
                  "format": "uint32",
                  "minimum": 0
                },
                "observation_id": {
                  "type": "string"
                },
                "start_span": {
                  "type": "integer",
                  "format": "uint32",
                  "minimum": 0
                }
              },
              "required": [
                "observation_id",
                "center",
                "start_span",
                "end_span"
              ]
            }
          },
          "required": [
            "name",
            "params"
          ]
        },
        {
          "description": "Replace the text of an editable element. Never allowed on sensitive fields.",
          "type": "object",
          "properties": {
            "name": {
              "type": "string",
              "const": "input.type"
            },
            "params": {
              "type": "object",
              "properties": {
                "element": {
                  "type": "string"
                },
                "observation_id": {
                  "type": "string"
                },
                "submit": {
                  "description": "Since 1.3: then press the keyboard's action key (Enter, Search,\nSend, Go, Done) in that field. Sent only to 1.3+ phones.",
                  "type": "boolean"
                },
                "text": {
                  "type": "string"
                }
              },
              "required": [
                "observation_id",
                "element",
                "text"
              ]
            }
          },
          "required": [
            "name",
            "params"
          ]
        },
        {
          "description": "Since 1.3: wait until an element whose text or description contains\n`text` (case-insensitive) is on screen, or until none is when `gone`.\nAnswers with a [`crate::WaitResult`] whose observation becomes the latest.",
          "type": "object",
          "properties": {
            "name": {
              "type": "string",
              "const": "ui.wait"
            },
            "params": {
              "type": "object",
              "properties": {
                "gone": {
                  "type": "boolean",
                  "default": false
                },
                "max_nodes": {
                  "type": "integer",
                  "format": "uint32",
                  "default": 400,
                  "minimum": 0
                },
                "text": {
                  "type": "string"
                },
                "timeout_ms": {
                  "type": "integer",
                  "format": "uint32",
                  "default": 5000,
                  "minimum": 0
                }
              },
              "required": [
                "text"
              ]
            }
          },
          "required": [
            "name",
            "params"
          ]
        },
        {
          "description": "Since 1.3: scroll `container` (or the largest scrollable element) in\n`direction` until an element containing `text` is visible, at most\n`max_swipes` times. Answers with an [`crate::ActionResult`] whose\n`found` says whether it got there.",
          "type": "object",
          "properties": {
            "name": {
              "type": "string",
              "const": "ui.scroll_to"
            },
            "params": {
              "type": "object",
              "properties": {
                "container": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "direction": {
                  "$ref": "#/$defs/Direction"
                },
                "max_swipes": {
                  "type": "integer",
                  "format": "uint32",
                  "default": 10,
                  "minimum": 0
                },
                "observation_id": {
                  "type": "string"
                },
                "text": {
                  "type": "string"
                }
              },
              "required": [
                "observation_id",
                "text",
                "direction"
              ]
            }
          },
          "required": [
            "name",
            "params"
          ]
        },
        {
          "type": "object",
          "properties": {
            "name": {
              "type": "string",
              "const": "nav.global"
            },
            "params": {
              "type": "object",
              "properties": {
                "action": {
                  "$ref": "#/$defs/GlobalAction"
                }
              },
              "required": [
                "action"
              ]
            }
          },
          "required": [
            "name",
            "params"
          ]
        },
        {
          "type": "object",
          "properties": {
            "name": {
              "type": "string",
              "const": "app.list"
            },
            "params": {
              "type": "object"
            }
          },
          "required": [
            "name",
            "params"
          ]
        },
        {
          "type": "object",
          "properties": {
            "name": {
              "type": "string",
              "const": "app.launch"
            },
            "params": {
              "type": "object",
              "properties": {
                "package": {
                  "type": "string"
                }
              },
              "required": [
                "package"
              ]
            }
          },
          "required": [
            "name",
            "params"
          ]
        },
        {
          "description": "Since 1.5: ask the owner to do something only a person should do (log\nin, unlock, type a code, choose). The phone shows `message` on a card\nwith \"Done\" and \"I can't\" and answers with an [`crate::ActionResult`]\nwhose `owner` holds the reply. Needs no capability; only the owner can\nanswer, never the AI.",
          "type": "object",
          "properties": {
            "name": {
              "type": "string",
              "const": "owner.ask"
            },
            "params": {
              "type": "object",
              "properties": {
                "message": {
                  "type": "string"
                }
              },
              "required": [
                "message"
              ]
            }
          },
          "required": [
            "name",
            "params"
          ]
        },
        {
          "description": "Since 1.6: list files in a location, newest first. `folder` is a\nfolder id from an earlier answer (location `folder` only); `query`\nfilters by name. Answers with a [`crate::FileList`].",
          "type": "object",
          "properties": {
            "name": {
              "type": "string",
              "const": "file.list"
            },
            "params": {
              "type": "object",
              "properties": {
                "folder": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "limit": {
                  "type": "integer",
                  "format": "uint32",
                  "default": 50,
                  "minimum": 0
                },
                "location": {
                  "$ref": "#/$defs/FileLocation"
                },
                "offset": {
                  "type": "integer",
                  "format": "uint32",
                  "minimum": 0
                },
                "query": {
                  "type": [
                    "string",
                    "null"
                  ]
                }
              },
              "required": [
                "location"
              ]
            }
          },
          "required": [
            "name",
            "params"
          ]
        },
        {
          "description": "Since 1.6: a look at one file: text, or a downscaled image. Answers\nwith a [`crate::FilePreview`].",
          "type": "object",
          "properties": {
            "name": {
              "type": "string",
              "const": "file.preview"
            },
            "params": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string"
                }
              },
              "required": [
                "id"
              ]
            }
          },
          "required": [
            "name",
            "params"
          ]
        },
        {
          "description": "Since 1.6: raw bytes of a file from `offset`, at most `length`.\nAnswers with a [`crate::FileChunk`].",
          "type": "object",
          "properties": {
            "name": {
              "type": "string",
              "const": "file.read"
            },
            "params": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string"
                },
                "length": {
                  "type": "integer",
                  "format": "uint32",
                  "minimum": 0
                },
                "offset": {
                  "type": "integer",
                  "format": "uint64",
                  "default": 0,
                  "minimum": 0
                }
              },
              "required": [
                "id",
                "length"
              ]
            }
          },
          "required": [
            "name",
            "params"
          ]
        },
        {
          "description": "Since 1.6: save bytes as a new file, or append them to a file this\nsession created (`append`). In `folder` the file goes into `folder`\n(a folder id, default the picked folder); in `photos` and\n`downloads` into `subfolder` (default \"Latch\"). An existing name is\nkept and the new file gets a free name, unless `overwrite`, which the\nowner approves. Answers with a [`crate::FileItem`].",
          "type": "object",
          "properties": {
            "name": {
              "type": "string",
              "const": "file.write"
            },
            "params": {
              "type": "object",
              "properties": {
                "append": {
                  "type": "boolean"
                },
                "data_base64": {
                  "type": "string"
                },
                "folder": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "location": {
                  "$ref": "#/$defs/FileLocation"
                },
                "mime": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "name": {
                  "type": "string"
                },
                "overwrite": {
                  "type": "boolean"
                },
                "subfolder": {
                  "type": [
                    "string",
                    "null"
                  ]
                }
              },
              "required": [
                "location",
                "name",
                "data_base64"
              ]
            }
          },
          "required": [
            "name",
            "params"
          ]
        },
        {
          "description": "Since 1.6: create a folder inside the picked folder (or `folder`).\nAnswers with a [`crate::FileItem`].",
          "type": "object",
          "properties": {
            "name": {
              "type": "string",
              "const": "file.mkdir"
            },
            "params": {
              "type": "object",
              "properties": {
                "folder": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "name": {
                  "type": "string"
                }
              },
              "required": [
                "name"
              ]
            }
          },
          "required": [
            "name",
            "params"
          ]
        },
        {
          "description": "Since 1.6: rename a file or folder. Answers with a [`crate::FileItem`].",
          "type": "object",
          "properties": {
            "name": {
              "type": "string",
              "const": "file.rename"
            },
            "params": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string"
                },
                "name": {
                  "type": "string"
                }
              },
              "required": [
                "id",
                "name"
              ]
            }
          },
          "required": [
            "name",
            "params"
          ]
        },
        {
          "description": "Since 1.6: delete a file or folder; the owner approves.",
          "type": "object",
          "properties": {
            "name": {
              "type": "string",
              "const": "file.delete"
            },
            "params": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string"
                }
              },
              "required": [
                "id"
              ]
            }
          },
          "required": [
            "name",
            "params"
          ]
        },
        {
          "description": "Since 1.6: open `package`'s Android share screen with these files\n(and optional text), so the owner or the AI can finish the post or\nmessage in that app. Answers with an [`crate::ActionResult`].",
          "type": "object",
          "properties": {
            "name": {
              "type": "string",
              "const": "app.share"
            },
            "params": {
              "type": "object",
              "properties": {
                "ids": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "package": {
                  "type": "string"
                },
                "text": {
                  "type": [
                    "string",
                    "null"
                  ]
                }
              },
              "required": [
                "package",
                "ids"
              ]
            }
          },
          "required": [
            "name",
            "params"
          ]
        },
        {
          "description": "Since 1.7 (ADR-027): download a whole file from `link`, decrypt it,\ncheck that its SHA-256 is `sha256`, and save it like `file.write`\n(same places, names, and overwrite rule). A file whose check fails is\nnever kept. The phone starts the download in the background and\nanswers with a [`crate::FileTransfer`] at once (or when it is done, if\nthat is quick); `file.transfer` follows it.",
          "type": "object",
          "properties": {
            "name": {
              "type": "string",
              "const": "file.fetch"
            },
            "params": {
              "type": "object",
              "properties": {
                "folder": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "link": {
                  "$ref": "#/$defs/FileLink"
                },
                "location": {
                  "$ref": "#/$defs/FileLocation"
                },
                "mime": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "name": {
                  "type": "string"
                },
                "overwrite": {
                  "type": "boolean"
                },
                "sha256": {
                  "description": "SHA-256 of the plain file, 64 lowercase hex characters.",
                  "type": "string"
                },
                "size": {
                  "description": "Plain size in bytes, when the gateway knows it (for the progress bar and the free-space check).",
                  "type": [
                    "integer",
                    "null"
                  ],
                  "format": "uint64",
                  "minimum": 0
                },
                "subfolder": {
                  "type": [
                    "string",
                    "null"
                  ]
                }
              },
              "required": [
                "location",
                "name",
                "link",
                "sha256"
              ]
            }
          },
          "required": [
            "name",
            "params"
          ]
        },
        {
          "description": "Since 1.7 (ADR-027): encrypt the file `id` and upload it to `link`, at\nmost `max_bytes`. Answers like `file.fetch`; when done the\n[`crate::FileTransfer`] carries the plain file's SHA-256.",
          "type": "object",
          "properties": {
            "name": {
              "type": "string",
              "const": "file.push"
            },
            "params": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string"
                },
                "link": {
                  "$ref": "#/$defs/FileLink"
                },
                "max_bytes": {
                  "type": "integer",
                  "format": "uint64",
                  "minimum": 0
                }
              },
              "required": [
                "id",
                "link",
                "max_bytes"
              ]
            }
          },
          "required": [
            "name",
            "params"
          ]
        },
        {
          "description": "Since 1.7: progress of a transfer this session started, waiting up to\n`wait_ms` for it to finish. With `cancel` the transfer stops and its\npartial file is removed. Answers with a [`crate::FileTransfer`], or\nwith the error that ended the transfer.",
          "type": "object",
          "properties": {
            "name": {
              "type": "string",
              "const": "file.transfer"
            },
            "params": {
              "type": "object",
              "properties": {
                "cancel": {
                  "type": "boolean"
                },
                "transfer": {
                  "type": "string"
                },
                "wait_ms": {
                  "type": "integer",
                  "format": "uint32",
                  "minimum": 0
                }
              },
              "required": [
                "transfer"
              ]
            }
          },
          "required": [
            "name",
            "params"
          ]
        },
        {
          "description": "Since 1.7: put `text` on the phone's clipboard, e.g. a caption to paste\ninto an app whose text box Latch cannot type into. Reading the\nclipboard is not offered. Answers with an [`crate::ActionResult`].",
          "type": "object",
          "properties": {
            "name": {
              "type": "string",
              "const": "clipboard.set"
            },
            "params": {
              "type": "object",
              "properties": {
                "text": {
                  "type": "string"
                }
              },
              "required": [
                "text"
              ]
            }
          },
          "required": [
            "name",
            "params"
          ]
        },
        {
          "description": "Since 1.8: the newest entries of the phone's activity log, newest\nfirst: apps the AI used, its actions, the owner's approvals and\nrefusals, files and folders it touched. Entries hold no screen\ncontent or typed text. `kinds` keeps only those kinds; `since_ms`\nonly entries at or after that time. Answers with an\n[`crate::ActivityList`].",
          "type": "object",
          "properties": {
            "name": {
              "type": "string",
              "const": "activity.list"
            },
            "params": {
              "type": "object",
              "properties": {
                "kinds": {
                  "type": "array",
                  "items": {
                    "$ref": "#/$defs/ActivityKind"
                  }
                },
                "limit": {
                  "type": "integer",
                  "format": "uint32",
                  "default": 50,
                  "minimum": 0
                },
                "since_ms": {
                  "type": [
                    "integer",
                    "null"
                  ],
                  "format": "uint64",
                  "minimum": 0
                }
              }
            }
          },
          "required": [
            "name",
            "params"
          ]
        },
        {
          "description": "Since 1.8: the AI finished the owner's task. The phone hides the\ncursor at once and logs `summary` (the AI's own words, at most 500\ncharacters). Changes nothing else. Answers with an\n[`crate::ActionResult`].",
          "type": "object",
          "properties": {
            "name": {
              "type": "string",
              "const": "task.done"
            },
            "params": {
              "type": "object",
              "properties": {
                "summary": {
                  "type": [
                    "string",
                    "null"
                  ]
                }
              }
            }
          },
          "required": [
            "name",
            "params"
          ]
        }
      ]
    },
    "CommandEnvelope": {
      "type": "object",
      "properties": {
        "command": {
          "$ref": "#/$defs/Command"
        },
        "confirm": {
          "anyOf": [
            {
              "$ref": "#/$defs/ConfirmRequest"
            },
            {
              "type": "null"
            }
          ]
        },
        "deadline_ms": {
          "description": "Milliseconds the device may spend, including waiting for approval.",
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "id": {
          "description": "Unique per gateway; used to correlate the result and for idempotency.",
          "type": "string"
        },
        "observe_after": {
          "description": "Since 1.2, actions only: observe after the action succeeded and return\nthe observation inside its result, saving the gateway a second command.\nGateways send it only to phones that said `hello` with 1.2 or later.",
          "anyOf": [
            {
              "$ref": "#/$defs/ObserveAfter"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "id",
        "deadline_ms",
        "command"
      ]
    },
    "ConfirmRequest": {
      "description": "Attached to a command when a human must approve it on the phone first.\n\nThe device shows `title` and `detail` verbatim, waits for the owner, and\nanswers `user_denied` or `confirmation_expired` instead of executing when\napproval does not arrive before the command deadline.",
      "type": "object",
      "properties": {
        "detail": {
          "type": "string"
        },
        "remember": {
          "description": "Since 1.3: present when the owner may answer \"allow for this session\"\nor \"always allow in this app\" instead of only \"once\". Absent for\ncritical actions (money, permissions, installs, account deletion),\nwhich are asked every time. The phone matches saved answers by this\nexact key and may still ignore it after its own live check.",
          "type": [
            "string",
            "null"
          ]
        },
        "risk": {
          "$ref": "#/$defs/RiskLevel"
        },
        "title": {
          "type": "string"
        }
      },
      "required": [
        "title",
        "detail",
        "risk"
      ]
    },
    "Direction": {
      "description": "Scroll direction, named after the content being revealed: `down` shows\nwhat is further down.",
      "type": "string",
      "enum": [
        "up",
        "down",
        "left",
        "right"
      ]
    },
    "FileLink": {
      "description": "Since 1.7 (ADR-027): where a whole file travels, for `file.fetch` and\n`file.push`. The phone streams the file to or from `url` itself, so its\nsize is not bound by command frames. What is stored there is always\nencrypted with AES-256-CTR under `key_hex` and `iv_hex`, a key made for\nthis one transfer that never goes to the storage; the plain file's\nSHA-256 travels separately, so any change on the way is caught.",
      "type": "object",
      "properties": {
        "headers": {
          "description": "Extra request headers the storage needs: lower-case names that start\nwith `x-`, or `content-type`.",
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "iv_hex": {
          "description": "16-byte initial counter block as 32 lowercase hex characters.",
          "type": "string"
        },
        "key_hex": {
          "description": "32-byte AES-256 key as 64 lowercase hex characters.",
          "type": "string"
        },
        "url": {
          "description": "`https://` (or the gateway's own `http://` origin on a LAN). The\nphone only accepts its own gateway's origin and the storage hosts the\nprotocol names (Vercel Blob).",
          "type": "string"
        }
      },
      "required": [
        "url",
        "key_hex",
        "iv_hex"
      ]
    },
    "FileLocation": {
      "description": "Where on the phone a file lives.",
      "oneOf": [
        {
          "description": "Photos and videos the owner allowed (Android's photo permission).\nNew files saved here appear in the gallery (`Pictures/<subfolder>`).",
          "type": "string",
          "const": "photos"
        },
        {
          "description": "The phone's Download folder (`Download/<subfolder>`). Without extra\npermissions the phone lists only files Latch saved there.",
          "type": "string",
          "const": "downloads"
        },
        {
          "description": "The one folder the owner picked in Latch, and its subfolders.",
          "type": "string",
          "const": "folder"
        }
      ]
    },
    "GlobalAction": {
      "type": "string",
      "enum": [
        "back",
        "home",
        "recents"
      ]
    },
    "ObserveAfter": {
      "description": "How to observe after an action (since 1.2). The phone applies the same\nrules as `ui.observe`: the `ui.observe` capability (and `screen.capture`\nfor a screenshot) must be enabled, and restricted screens are refused.",
      "type": "object",
      "properties": {
        "include_screenshot": {
          "type": "boolean",
          "default": false
        },
        "max_nodes": {
          "type": "integer",
          "format": "uint32",
          "default": 400,
          "minimum": 0
        },
        "quiet_ms": {
          "description": "Since 1.3: observe as soon as the screen has not changed for this many\nmilliseconds (at most 1000), waiting at most `settle_ms` in all. Older\nphones ignore it and wait the full `settle_ms`.",
          "type": [
            "integer",
            "null"
          ],
          "format": "uint32",
          "minimum": 0
        },
        "settle_ms": {
          "description": "Milliseconds to let the UI settle before observing, at most 3000.",
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        }
      },
      "required": [
        "settle_ms"
      ]
    },
    "Point": {
      "description": "A point in physical screen pixels of the observation it was taken from.",
      "type": "object",
      "properties": {
        "x": {
          "type": "integer",
          "format": "int32"
        },
        "y": {
          "type": "integer",
          "format": "int32"
        }
      },
      "required": [
        "x",
        "y"
      ]
    },
    "RiskLevel": {
      "type": "string",
      "enum": [
        "low",
        "medium",
        "high"
      ]
    },
    "Target": {
      "description": "What an input command acts on.\n\nElement targets are preferred: the device re-resolves the element from the\nreferenced observation and refuses if it moved, vanished, or is sensitive.\nPoint targets are only accepted together with a fresh observation id.",
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "element": {
              "type": "string"
            }
          },
          "required": [
            "element"
          ]
        },
        {
          "type": "object",
          "properties": {
            "x": {
              "type": "integer",
              "format": "int32"
            },
            "y": {
              "type": "integer",
              "format": "int32"
            }
          },
          "required": [
            "x",
            "y"
          ]
        }
      ]
    }
  }
}
