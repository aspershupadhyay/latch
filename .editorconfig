# Shared editor settings; each language's formatter (rustfmt, ktlint rules in
# Android lint, TypeScript's compiler) stays the authority on style.
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{ts,mjs,js,json,yml,yaml,html,css}]
indent_size = 2

[*.md]
trim_trailing_whitespace = false

[Makefile]
indent_style = tab
